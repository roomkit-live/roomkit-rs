{
  "$schema": "../../scenario.schema.json",
  "id": "server-instructions/a-server-s-text-past-8192-characters-is-cut",
  "title": "A server's instructions past 8192 characters are cut in the prompt, and a text of 8192 characters is kept whole",
  "rules": [
    "§21.2"
  ],
  "requirements": [
    "RK-21.2-041"
  ],
  "notes": "Python: channels/_server_instructions.py _server_section (MAX_SERVER_INSTRUCTIONS_CHARS) and _text.bounded_text; roomkit-rs: roomkit-ai server_instructions.rs. files publishes 8193 characters, the last of which the prompt does not hold; crm publishes 8192 characters, its last one kept. How the cut text ends is the implementation's. Not observed: the warning naming the server, a log no step reads.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Hello."
            }
          ]
        },
        "server_instructions": {
          "files": "",
          "crm": ""
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "generation",
        "trigger": "before_ai_generation"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hi."
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "system_prompt": {
            "$contains": [
              "<server_instructions>\nAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
              "crm",
              "<server_instructions>\nBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
              "BBBBZ\n</server_instructions>"
            ]
          }
        }
      ]
    },
    "hooks": {
      "generation": [
        {
          "trigger": "before_ai_generation",
          "generation": {
            "system_prompt": {
              "$lacks": "AY"
            }
          }
        }
      ]
    }
  }
}
