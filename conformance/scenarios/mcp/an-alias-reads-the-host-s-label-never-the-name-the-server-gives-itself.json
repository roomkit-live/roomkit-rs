{
  "$schema": "../../scenario.schema.json",
  "id": "mcp/an-alias-reads-the-host-s-label-never-the-name-the-server-gives-itself",
  "title": "An MCP alias names a server by the host's label for it: each server serves the alias of its label, never one of the name it gives itself in its handshake",
  "rules": [
    "§21.2"
  ],
  "requirements": [
    "RK-21.2-012"
  ],
  "notes": "Python: tools/mcp.py MCPToolProvider (label), tests/test_mcp_alias_policy.py; roomkit-rs: roomkit-mcp provider.rs. Two labelled servers each give themselves the other's label as their name. Their tools are declared under their aliases; each alias runs on the server whose label it names. The label's refusals at construction are mcp-host/a-label-that-cannot-name-its-server-in-an-alias-is-refused-at-construction.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "mcp__files__lookup",
                  "arguments": {
                    "query": "q"
                  }
                },
                {
                  "id": "call-2",
                  "name": "mcp__crm__lookup",
                  "arguments": {
                    "query": "q"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "mcp_servers": [
          {
            "label": "files",
            "server_name": "crm",
            "declare": "aliases",
            "tools": [
              {
                "name": "lookup",
                "description": "Look up.",
                "input_schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query"
                  ]
                },
                "returns": "files server"
              }
            ]
          },
          {
            "label": "crm",
            "server_name": "files",
            "declare": "aliases",
            "tools": [
              {
                "name": "lookup",
                "description": "Look up.",
                "input_schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query"
                  ]
                },
                "returns": "crm server"
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up in both."
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "mcp__files__lookup": 0,
            "mcp__crm__lookup": 1
          },
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "name": "mcp__files__lookup",
              "content": "files server",
              "is_error": false
            },
            {
              "tool_call_id": "call-2",
              "name": "mcp__crm__lookup",
              "content": "crm server",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
