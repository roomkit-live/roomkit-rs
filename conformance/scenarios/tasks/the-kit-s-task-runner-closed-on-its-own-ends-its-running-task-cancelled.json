{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/the-kit-s-task-runner-closed-on-its-own-ends-its-running-task-cancelled",
  "title": "The kit's task runner closed on its own, the kit left open, cancels the task it holds running: the task ends cancelled",
  "rules": [
    "§23.1",
    "§23.3"
  ],
  "requirements": [
    "RK-23.1-009"
  ],
  "notes": "Python: tests/tasks/test_runner.py::TestInMemoryTaskRunner::test_close_cancels_all_inflight; tasks/memory.py InMemoryTaskRunner.close. The worker's turn is held at a gate, so the task is running when the runner closes; a cancel afterwards answers false, as for any task that ended. Cited in part: the release of the runner's resources is not observed.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Count to a thousand."
            },
            "gate": "counting",
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "A thousand."
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "completed",
        "trigger": "on_task_completed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "worker",
      "task": "Count to a thousand.",
      "as": "t"
    },
    {
      "wait_for": "counting"
    },
    {
      "call": "task_runner.close",
      "expect": {
        "result": null
      }
    },
    {
      "call": "task.wait",
      "task_id": "$t",
      "expect": {
        "result": {
          "status": "cancelled",
          "output": null,
          "child_room_id": "$r1"
        }
      }
    },
    {
      "call": "cancel_task",
      "task_id": "$t",
      "expect": {
        "result": false
      }
    },
    {
      "open": "counting"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "rooms": {
      "$r1": {
        "metadata": {
          "task_status": "cancelled",
          "task_result": null
        }
      }
    },
    "hooks": {
      "completed": [
        {
          "trigger": "on_task_completed",
          "room_id": "room-1",
          "event": {
            "type": "task_completed",
            "metadata": {
              "agent_id": "worker",
              "task_status": "cancelled"
            }
          }
        }
      ]
    }
  }
}
