{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-required-intent-refuses-no-call-that-comes-without-it",
  "title": "With call intents required, a call that comes without _roomkit_intent runs, and its start and end carry no intent",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-105"
  ],
  "notes": "Python: providers/ai/tool_intent.py presented_tools (the requirement asks the model, it refuses no call), take_intent; tests/test_channels/test_tool_call_intents.py.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "publish_tool_call_text": true,
        "tool_call_intents": true,
        "tool_call_intents_required": true,
        "tools": [
          {
            "name": "shell",
            "description": "Run a command.",
            "parameters": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "string"
                }
              }
            },
            "returns": "a.txt"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "shell",
                  "arguments": {
                    "command": "ls"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "tool_calls": [
            {
              "name": "shell",
              "arguments": {
                "command": "ls"
              },
              "intent": {
                "$absent": true
              }
            }
          ],
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "tool_call_end",
          "tool_calls": [
            {
              "name": "shell",
              "result": "a.txt",
              "status": "completed",
              "intent": {
                "$absent": true
              }
            }
          ],
          "round": 0,
          "channel_id": "agent",
          "duration_ms": {
            "$present": true
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "name": "shell",
              "content": "a.txt",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
