{
  "$schema": "../../scenario.schema.json",
  "id": "tools/an-intents-list-limits-what-is-shown-not-what-is-read",
  "title": "With call intents limited to a list of tools, a call to a tool the list does not name that carries _roomkit_intent has it taken out of its arguments as its intent",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-107"
  ],
  "notes": "Python: providers/ai/tool_intent.py take_intent, owning_tools.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "publish_tool_call_text": true,
        "tool_call_intents": true,
        "tool_call_intents_only": [
          "shell"
        ],
        "tools": [
          {
            "name": "shell",
            "description": "Run a command.",
            "parameters": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "string"
                }
              }
            },
            "returns": "a.txt"
          },
          {
            "name": "reader",
            "description": "Read a file.",
            "parameters": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              }
            },
            "returns": "contents"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "reader",
                  "arguments": {
                    "path": "a.txt",
                    "_roomkit_intent": "Je lis."
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "tool_calls": [
            {
              "name": "reader",
              "arguments": {
                "path": "a.txt",
                "_roomkit_intent": {
                  "$absent": true
                }
              },
              "intent": "Je lis."
            }
          ],
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "tool_call_end",
          "tool_calls": [
            {
              "name": "reader",
              "result": "contents",
              "status": "completed",
              "intent": "Je lis."
            }
          ],
          "round": 0,
          "channel_id": "agent",
          "duration_ms": {
            "$present": true
          }
        }
      ]
    }
  }
}
