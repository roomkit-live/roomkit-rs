{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-delivery-refused-for-want-of-a-recipient-is-no-failure-of-its-channel-s-breaker",
  "title": "A delivery refused before any send because its binding names no recipient counts as none of the failures that open the channel's breaker, which every room on the channel shares: after four failures and such a refusal, the next delivery is still sent",
  "rules": [
    "§13.1",
    "§10.2 step 3d"
  ],
  "requirements": [
    "RK-13.1-008"
  ],
  "notes": "The breaker's threshold and cooldown are the RFC's defaults (§13.1), the only ones both implementations have. room-1's binding names its recipient, room-2's none. After four failed deliveries in room-1 and room-2's refusal, room-1's next delivery reaches the channel: it is the fifth failure that opens the breaker, and the delivery after it is not sent.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "deliver": [
          {
            "fail": "down",
            "repeat": true
          }
        ]
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "sms",
            "metadata": {
              "phone_number": "+15551234567"
            }
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "delivery_results": {
            "sms": {
              "status": "failed"
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
