    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "probe"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "delivery_results": {
            "ws": {
              "status": "failed"
            }
          }
